# DeepSeek API
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat
# Strict tool transport canary. Empty = installed JSON transport for all clients.
DEEPSEEK_TOOL_CLIENT_IDS=
DEEPSEEK_TOOL_SCOPE=allowlist

# Local isolated GigaAM worker; enable after staging/native verification.
VOICE_MEDIA_ENABLED=false
VOICE_PYTHON_EXECUTABLE=
VOICE_MODEL_DIR=

# Instagram (Meta Graph API)
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=EAAxxx
INSTAGRAM_VERIFY_TOKEN=my_secret_token
INSTAGRAM_PAGE_ID=123456789
INSTAGRAM_IG_USER_ID=123456789
INSTAGRAM_APP_ID=123456789012345

# Exact advertising media: separate System User ads_read credential, never PAGE token.
ADS_MEDIA_ENABLED=false
INSTAGRAM_ADS_ACCOUNT_ID=
INSTAGRAM_ADS_ACCOUNT_IDS=
INSTAGRAM_ADS_TOKEN_FILE=credentials/meta-ads/token.txt

# Telegram Bot (уведомления менеджерам)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_MANAGER_CHAT_ID=123456789
TELEGRAM_EXTRA_CHAT_ID=

# ChromaDB (RAG FAQ)
CHROMA_DB_DIR=data/chroma

# DuckDNS (автообновление IP)
DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=travelagenttest

# Manager takeover — пауза бота при ответе живого менеджера
MANAGER_TAKEOVER_TTL_MINUTES=10080

# Одна дополнительная проверка только модельных консультаций; не обязательных маршрутов.
MANAGER_REVIEW_ENABLED=true
MANAGER_REVIEW_TIMEOUT_SECONDS=25

# Сколько последних реплик диалога уходит в LLM (считаются и сообщения клиента,
# и ответы бота: 50 ≈ 25 обменов)
MAX_HISTORY_MESSAGES=50

# Через сколько часов молчания сбрасывается счётчик эскалаций (720 = 30 дней)
ESCALATION_RESET_HOURS=720

# Токен для служебных /api/admin/* роутов. Пока пустой — роуты отдают 404.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Синхронизация туров из Google Drive (.kiro/specs/tour-sync/).
# Два способа доступа (файл сервисного аккаунта в приоритете):
# 1) сервисный аккаунт: JSON-ключ только на сервере + расшарить на него папку;
# 2) API-ключ: Google Cloud Console → Drive API → ключ только для Drive API.
# Оба — только в серверный .env (в репозиторий не попадут, см. .gitignore).
# Пока не заданы FOLDER_ID и доступ — sync спит, бот работает по tours/*.docx.
TOUR_SYNC_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_API_KEY=
# Связки «имя документа = URL брони» для документов, которые совпадением
# по имени не матчится с базой. Значение — URL, не имя тура.
# TOUR_SYNC_NAME_ALIASES=Эльбрус 2027=https://sundita.by/tur/gornolyzhnyj-otdyh-na-elbruse/;Варшава-Дрезден-Прага=https://sundita.by/tur/varshava-drezden-praga
# TOUR_SYNC_INTERVAL_SECONDS=300
# TOUR_SYNC_MIN_TOURS=1
# TOUR_SYNC_NOTIFY=True

# Настройки
LOG_LEVEL=INFO
DEEPSEEK_RESPONSE_LOG_ENABLED=true
HOST=0.0.0.0
PORT=8000

# Восстановление входящих: включать только после production read-only gate.
INBOUND_RECOVERY_ENABLED=false
INBOUND_RECOVERY_SCOPE=allowlist
# CSV of verified numeric Instagram sender IDs; required before enabling allowlist.
INBOUND_RECOVERY_CLIENT_IDS=
INSTAGRAM_RECONCILE_ENABLED=false
INBOUND_WATCHDOG_SECONDS=60
INBOUND_RETRY_FIRST_SECONDS=120
INBOUND_RETRY_SECOND_SECONDS=480
INBOUND_SEMANTIC_RECHECK_SECONDS=120
INSTAGRAM_RECONCILE_INTERVAL_SECONDS=120
